# Put your Datadog keys here, not in src/logscraper/config.py.
# DD_API_KEY plus DD_APP_KEY or DD_APPLICATION_KEY are also accepted.
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_FETCH_MODE=api
# Optional override; otherwise derived from DATADOG_SITE.
DATADOG_MCP_URL=
DATADOG_MCP_CA_BUNDLE=
DATADOG_MCP_VERIFY_SSL=true
DATADOG_MCP_USE_WINDOWS_CERT_STORE=true
DATADOG_SERVICE=
DATADOG_ENV=prod
DATADOG_LOG_LEVELS=ERROR,CRITICAL,FATAL
DATADOG_LOOKBACK_MINUTES=60
DATADOG_PRIMARY_QUERY=
DATADOG_FALLBACK_QUERY=
DATADOG_INITIAL_LOOKBACK_DAYS=0
DATADOG_EXPANDED_LOOKBACK_DAYS=0
DATADOG_INCLUDE_INFERRED_ERRORS=true
DATADOG_ERROR_KEYWORDS=[ERR],error,exception,failed,fatal,stack trace

GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BASE_BRANCH=main

OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=LogScraper
LANGSMITH_CA_BUNDLE=
LANGSMITH_USE_WINDOWS_CERT_STORE=true
LANGSMITH_WINDOWS_CA_BUNDLE_PATH=./data/langsmith-windows-ca-bundle.pem

DB_PATH=./data/logscraper.db
DRY_RUN=true
# Optional local fallback. When GitHub settings are present, the agent clones the repo into data/workspaces.
DOTNET_REPO_PATH=
WORKFLOW_GRAPH_PATH=
WORKFLOW_GRAPH_ONLY=false

MAX_LOGS_PER_RUN=1000
SIMILARITY_THRESHOLD=0.85
